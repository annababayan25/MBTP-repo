@using System.Data
@using MBTP.Controllers
@using MBTP.Retrieval
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

@{
 DateTime startDate = (DateTime)ViewBag.FiscalYearStartDate;
    string? fiscalYear = Context.Session.GetString("FiscalYear");
    string? isCurrentFiscalYear = Context.Session.GetString("IsCurrentFiscalYear");
    DateTime currentDate = DateTime.Now;
    int monthIndex = 0;
    int dataRecordRow = 0;

    decimal totalFood = 0;
    decimal totalKay = 0;
    decimal totalPed = 0;
    decimal totalMisc = 0;
    decimal totalTotal = 0;
    decimal totalCollected = 0;
    decimal totalRevenue = 0;
    decimal totalExpected = 0;
}
<div class='head-container'>
    <h1>Month-By-Month Information for Fiscal Year @fiscalYear</h1>
    <p>&nbsp;</p>
    <a class="pdfButton" asp-area="" asp-controller="FDB" asp-action="Yearly">Back to yearly</a>
    <p>&nbsp;</p>
    <p>single click a specific month for its daily breakdown</p>
</div>

<body>
   @if (Model is not null && Model.Tables[0].Rows.Count > 0)
    {
<div class="table-responsive " style="max-height: 75vh; overflow-y: auto;"> 
<table id="monthly-table" class="breakdown clickable-tableK" style="width:240px; border: none;">
    <tr>
        <th class="breakdownBigTitle" colspan="9">Kayak Shack</th>
    </tr>
    <tr>
        <th class="breakdownMonthScrolling"></th>
        <th class="breakdownTitle" colspan="1">317</th>
        <th class="breakdownTitle" colspan="1">353</th>
        <th class="breakdownTitle" colspan="1">354</th>
        <th class="breakdownTitle" rowspan="2">Misc Sales</th>
        <th class="breakdownTotalsHead" rowspan="2">Total Gross Revenue</th>
        <th class="breakdownTotalsHead" rowspan="2">Total Tax Collected</th>
        <th class="breakdownTotalsHead" rowspan="2">Total Net Revenue</th>
        <th class="breakdownTaxHead" rowspan="2">Total Tax Expected</th>
    </tr>
    <tr>
        <th class="breakdownMonthScrollingBottom">Month</th>
        <th class="breakdownTitle">Food Sales</th>
        <th class="breakdownTitle">Kayaks and Boards</th>
        <th class="breakdownTitle">Pedal Boats</th>
        
    </tr>
   @foreach (DataRow row in Model!.Tables[0].Rows)
    {
        dataRecordRow++;
        var breakdownMonthClass = new System.Text.StringBuilder("breakdownMonth");
        var breakdownDataClass = new System.Text.StringBuilder("breakdownData");
        var breakdownTotalsClass = new System.Text.StringBuilder("breakdownTotals");
        var breakdownTaxClass = new System.Text.StringBuilder("breakdownTax");
        if(dataRecordRow == 1)
        {
            breakdownMonthClass.Remove(0, "breakdownMonth".Length).Append("breakdownMonthTop");
            breakdownDataClass.Remove(0, "breakdownData".Length).Append("breakdownDataTop");
            breakdownTotalsClass.Remove(0, "breakdownTotals".Length).Append("breakdownTotalsTop");
            breakdownTaxClass.Remove(0, "breakdownTax".Length).Append("breakdownTaxTop");
        }
        breakdownMonthClass.ToString();
        breakdownDataClass.ToString();
        breakdownTotalsClass.ToString();
        breakdownTaxClass.ToString();
        var monthDate = startDate.AddMonths(monthIndex);
        var month = startDate.AddMonths(monthIndex).ToString("MMMM");
        var ThirP = 1.08m;
        var TenP = 1.105m;

        var noTaxFood = (decimal)row["NonTaxFoodK"];
        var PreparedFood = (decimal)row["PreparedFoodK"];
        var combinedFood = noTaxFood + PreparedFood;
        var KayBo= (decimal)row["KayAndBo"];
        var PedBo= (decimal)row["PedBo"];
        var Misc= (decimal)row["MiscK"];
        var total = ((PedBo+KayBo))+Misc+noTaxFood+PreparedFood;
        var taxCollected = (decimal)row["TaxK"];
        var netRevenue = ((PedBo+KayBo)/ThirP)+Misc+noTaxFood+(PreparedFood/TenP);
        var taxExpected = PedBo+KayBo-((PedBo+KayBo)/ThirP) + PreparedFood - (PreparedFood/TenP);

        totalFood += noTaxFood + PreparedFood;
        totalKay += KayBo;
        totalPed += PedBo;
        totalMisc += Misc;
        totalTotal += total;
        totalCollected += taxCollected;
        totalRevenue += netRevenue;
        totalExpected += taxExpected;
   <tr class="colorAlt" data-month="@monthDate.Month" data-year="@monthDate.Year">
        <td class="@breakdownMonthClass">@month</td>
        <td class="@breakdownDataClass">@(@combinedFood != 0 ? String.Format("{0:c2}", @combinedFood) : "")</td>
        <td class="@breakdownDataClass">@(@KayBo != 0 ? String.Format("{0:c2}", @KayBo) : "")</td>
        <td class="@breakdownDataClass">@(@PedBo != 0 ? String.Format("{0:c2}", @PedBo) : "")</td>
        <td class="@breakdownDataClass">@(@Misc != 0 ? String.Format("{0:c2}", @Misc) : "")</td>
        <td class="@breakdownTotalsClass">@(@total != 0 ? String.Format("{0:c2}", @total) : "")</td>
        <td class="@breakdownTotalsClass">@(@taxCollected != 0 ? String.Format("{0:c2}", @taxCollected) : "")</td>
        <td class="@breakdownTotalsClass">@(@netRevenue != 0 ? String.Format("{0:c2}", @netRevenue) : "")</td>
        <td class="@breakdownTaxClass">@(@taxExpected != 0 ? String.Format("{0:c2}", @taxExpected) : "")</td>
   </tr>
   monthIndex ++;
}
<tr>
        <td class="breakdownTotalsScrolling" style="border-bottom: 1px solid black;">Totals:</td>
        <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalFood != 0 ? String.Format("{0:c2}", @totalFood) : "")</td>
        <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalKay != 0 ? String.Format("{0:c2}", @totalKay) : "")</td>
        <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalPed != 0 ? String.Format("{0:c2}", @totalPed) : "")</td>
        <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalMisc != 0 ? String.Format("{0:c2}", @totalMisc) : "")</td>
        <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalTotal != 0 ? String.Format("{0:c2}", @totalTotal) : "")</td>
        <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalCollected != 0 ? String.Format("{0:c2}", @totalCollected) : "")</td>
        <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalRevenue != 0 ? String.Format("{0:c2}", @totalRevenue) : "")</td>
        <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalExpected != 0 ? String.Format("{0:c2}", @totalExpected) : "")</td>
   </tr>
</table>
</div>
}
else
{
    <div class="no-data-message">
        <p>No data available for the selected fiscal year.</p>
    </div>
}
</body>
<script>
$(document).ready(function () {
    $("#monthly-table").on("click", "tr", function () {
        var year = $(this).data("year");
        var month = $(this).data("month");
        var date = new Date(year, month - 1, 1); // JavaScript months are 0-based
        var url = `/FDB/DailyBreakdownK?date=${date.toISOString()}&whichMonth=None`;
        console.log('single-click detected on table row. URL:', url);
        if (url) {
            console.log('Navigating to:', url);
            window.location.href = url;
        } else {
            console.error('URL is undefined');
        }
    });
});
</script>
