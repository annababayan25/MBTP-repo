@using System.Data
@using MBTP.Controllers
@using MBTP.Retrieval

<link rel="stylesheet" type="text/css" href="~/css/site.css" />
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var accID = User.FindFirst("AccID")?.Value;
    
    var curMonthIncomeList = ViewBag.curMonthIncome as List<dynamic>;
    var priorMonthIncomeList = ViewBag.priorMonthIncome as List<dynamic>;
    var curYearIncomeList = ViewBag.curYearIncome as List<dynamic>;
    var priorYearIncomeList = ViewBag.priorYearIncome as List<dynamic>;

    var taxableReservationsListD = ViewBag.TaxableReservationsD as List<dynamic>;
    var lastMonthIncomeListD = ViewBag.LastMonthIncomeD as List<dynamic>;
    var lastYearIncomeListD = ViewBag.LastYearIncomeD as List<dynamic>;
    var twoYearIncomeListD = ViewBag.TwoYearIncomeD as List<dynamic>;

    bool isPdf = false;
    object? isPdfObj = ViewData["IsPdf"];
    if(isPdfObj != null)
    {
        isPdf = (bool)isPdfObj;
    }

    // Dynamic date calculations
    var startDate = ViewBag.StartDate != null ? (DateTime)ViewBag.StartDate : DateTime.Now;
    var currentMonth = startDate.ToString("MMM yyyy");
    var lastMonth = startDate.AddYears(-1).ToString("MMM yyyy");
    var lastYear = startDate.AddYears(-1).ToString("MMM yyyy");
    var twoYearsAgo = startDate.AddYears(-2).ToString("MMM yyyy");
    var fiscalYear = startDate.Year;
    var lastFiscalYear = fiscalYear - 1;
    var twoFiscalYearsAgo = fiscalYear - 2;
    var whichMonth = ViewBag.WhichMonth == null || ViewBag.WhichMonth == "Current" ? "Prior" : "Current";
    string monthText;
    if(ViewBag.WhichMonth == null || ViewBag.WhichMonth == "Current")
    {
        monthText = "View " + startDate.AddMonths(-1).ToString("MMM yyyy");
    }
    else
    {
        monthText = "View " + startDate.AddMonths(+1).ToString("MMM yyyy");
    }
    var fyChangeHdr = "FY"+ lastFiscalYear.ToString().Substring(2) + "/FY" + twoFiscalYearsAgo.ToString().Substring(2) + " +/-";
}
<script>
    var isChrome = /Chrome/.test(navigator.userAgent) && /Google Inc/.test(navigator.vendor);
    if(isChrome){
        document.body.classList.add('chrome');
    }
</script>
<style>
    @@media(max-width: 400px) {
        .chrome .inc{
            transform: scale(0.5); /* Adjust the scale factor as needed */
            transform-origin: top left;
            margin-left: -2%;
            margin-bottom: 0; /* Add margin bottom to create space between tables */
            padding-bottom:0;
        }
        .chrome .dep{
            transform: scale(0.5); /* Adjust the scale factor as needed */
            transform-origin: top left;
            margin-left: -2%;
            margin-bottom: 0; /* Add margin bottom to create space between tables */
            padding-bottom:0;
        }
        .inc, .dep {
            transform: scale(0.5); /* Adjust the scale factor as needed */
            margin-bottom: 0; /* Add margin bottom to create space between tables */
            padding-bottom:0;
        }
    }

    @@media(min-width: 401px) {
        .tables-wrapper {
            display: flex;
            justify-content: space-between;
            margin: 1px; /* Adjust overall margin as needed */
        }

        .table-container {
            flex-basis: 48%;
            margin-bottom: 10px; /* Optional: Add margin between table containers */
        }
    }

    .data-table {
        border-collapse: collapse;
        width: 100%;
    }

    .data-table th,
    .data-table td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: center;
    }

    .data-table th {
        background-color: #f2f2f2;
    }

    .data-table .negative-value {
        color: red;
    }
    .table-container{
        flex-basis: 48%;
        margin-bottom: 0;
        padding-bottom: 0;
    }
    h1,h4{
        margin:0;
        padding:0;
    }
</style>
<body>
@if(accID != "8")
{
    <div class="button-container">
        <div>&nbsp;</div>
        <a class="pdfButton" asp-area="" asp-controller="FDB" asp-action="Snapshot" asp-route-whichMonth=@whichMonth>@monthText</a>
    </div>
    <div class="tables-wrapper">
        <div class="table-container">
            <div class="myContainer">
                @if (curMonthIncomeList is not null && curMonthIncomeList.Count > 0)
                {
                    <div class="table-wrapper">
                        <h1 style="text-align:center" class="inc">Income Snapshot (Net Revenue)</h1>
                        <table id="income-snapshot-table" class="data-table inc">
                            <thead>
                                <tr>
                                    <th style="background-color:rgb(63, 62, 62)" class="snapshot" colspan="1" rowspan="2">Revenue<br>Source</th>
                                    <th style="background-color:rgb(63, 62, 62)" class="snapHEAD" colspan="3" class="snap1"> Month-Over-Month To Date</th>
                                    <th style="background-color:rgb(63, 62, 62)" class="snapHEAD" colspan="3" class="snap1"> Year-Over-Year To Date</th>
                                </tr>
                                <tr>
                                    <th class="snap1">@currentMonth</th>
                                    <th class="snap1">@lastMonth</th>
                                    <th class="snap1">@currentMonth +/-</th>
                                    <th class="snap1"> FY @lastFiscalYear</th>
                                    <th class="snap1"> FY @twoFiscalYearsAgo</th>
                                    <th class="snap1"> @fyChangeHdr</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < curMonthIncomeList.Count; i++)
                                {
                                    var curMonthIncome = curMonthIncomeList[i];
                                    var priorMonthIncome = (priorMonthIncomeList != null && i < priorMonthIncomeList.Count) ? priorMonthIncomeList[i] : null;
                                    var curYearIncome = (curYearIncomeList != null && i < curYearIncomeList.Count) ? curYearIncomeList[i] : null;
                                    var priorYearIncome = (priorYearIncomeList != null && i < priorYearIncomeList.Count) ? priorYearIncomeList[i] : null;
                                    @if(accID != "4" && accID != "5")
                                    {
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">Taxable <br> Reservations:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.TaxableReservationsNetRevenue)</td>
                                            <td class="snap2">@String.Format("{0:F2}", priorMonthIncome != null ? priorMonthIncome.ResTaxIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.TaxableReservationsNetRevenue - (priorMonthIncome != null ? priorMonthIncome.ResTaxIncome : 0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.ResTaxIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.ResTaxIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.ResTaxIncome : 0m) - (priorYearIncome != null ? priorYearIncome.ResTaxIncome : 0m)))</td>
                                        </tr>
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">No-Tax <br> Reservations:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.NoTaxReservationsNetRevenue)</td>
                                            <td class="snap2">@String.Format("{0:F2}", priorMonthIncome != null ? priorMonthIncome.ResNoTaxIncome : 0m)</td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.NoTaxReservationsNetRevenue - (priorMonthIncome != null ? priorMonthIncome.ResNoTaxIncome : 0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.ResNoTaxIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.ResNoTaxIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.ResNoTaxIncome : 0m) - (priorYearIncome != null ? priorYearIncome.ResNoTaxIncome : 0m)))</td>
                                        </tr>
                                    }
                                    @if(accID != "3" && accID != "5")
                                    {
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">General Store:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.StoreNetRevenue)</td>
                                            <td class="snap2">@String.Format("{0:F2}", priorMonthIncome != null ? priorMonthIncome.StoreIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.StoreNetRevenue - (priorMonthIncome != null ? priorMonthIncome.StoreIncome : 0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.StoreIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.StoreIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.StoreIncome : 0m) - (priorYearIncome != null ? priorYearIncome.StoreIncome : 0m)))</td>
                                        </tr>
                                    }
                                    @if(accID != "3" && accID != "4")
                                    {
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">Snack Bar:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.SnackBarNetRevenue)</td>
                                            <td class="snap2">@String.Format("{0:F2}", priorMonthIncome != null ? priorMonthIncome.SnackIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.SnackBarNetRevenue - (priorMonthIncome != null ? priorMonthIncome.SnackIncome : 0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.SnackIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.SnackIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.SnackIncome : 0m) - (priorYearIncome != null ? priorYearIncome.SnackIncome : 0m)))</td>
                                        </tr>
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">Arcade Games:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.ArcadeGamesRevenue)</td>
                                            <td class="snap2">@String.Format("{0:F2}", priorMonthIncome != null ? priorMonthIncome.ArcadeIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.ArcadeGamesRevenue - (priorMonthIncome != null ? priorMonthIncome.ArcadeIncome : 0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.ArcadeIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.ArcadeIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.ArcadeIncome : 0m) - (priorYearIncome != null ? priorYearIncome.ArcadeIncome : 0m)))</td>
                                        </tr>
                                    }
                                    @if(accID != "3" && accID != "4" && accID != "5")
                                    {
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">Kayak Shack:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.KayakShackRevenue)</td>
                                            <td class="snap2">@String.Format("{0:F2}", priorMonthIncome != null ? priorMonthIncome.KayakIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.KayakShackRevenue - (priorMonthIncome != null ? priorMonthIncome.KayakIncome : 0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.KayakIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.KayakIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.KayakIncome : 0m) - (priorYearIncome != null ? priorYearIncome.KayakIncome : 0m)))</td>
                                        </tr>
                                    }
                                    @if(accID != "3" && accID != "4")
                                    {
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">Coffee Trailer:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.CoffeeTrailerRevenue)</td>
                                            <td class="snap2">@String.Format("{0:F2}", priorMonthIncome != null ? priorMonthIncome.CoffeeIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.CoffeeTrailerRevenue - (priorMonthIncome != null ? priorMonthIncome.CoffeeIncome : 0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.CoffeeIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.CoffeeIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.CoffeeIncome : 0m) - (priorYearIncome != null ? priorYearIncome.CoffeeIncome : 0m)))</td>
                                        </tr>
                                    }
                                    @if(accID != "3" && accID != "5")
                                    {
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">Propane Sales:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.PropaneSalesRevenue)</td>
                                            <td class="snap2">@String.Format("{0:F2}", priorMonthIncome != null ? priorMonthIncome.PropaneIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.PropaneSalesRevenue - (priorMonthIncome != null ? priorMonthIncome.PropaneIncome : 0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.PropaneIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.PropaneIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.PropaneIncome : 0m) - (priorYearIncome != null ? priorYearIncome.PropaneIncome : 0m)))</td>
                                        </tr>
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">Laundry:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.LaundryRevenue)</td>
                                            <td class="snap2">@String.Format("{0:F2}", priorMonthIncome != null ? priorMonthIncome.LaundryIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.LaundryRevenue - (priorMonthIncome != null ? priorMonthIncome.LaundryIncome : 0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.LaundryIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.LaundryIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.LaundryIncome : 0m) - (priorYearIncome != null ? priorYearIncome.LaundryIncome : 0m)))</td>
                                        </tr>
                                    }
                                    @if(accID != "3" && accID != "4")
                                    {
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">Activities/Events:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.ActivitiesEventsRevenue)</td>
                                            <td class="snap2">@String.Format("{0:F2}", priorMonthIncome != null ? priorMonthIncome.EventsIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.ActivitiesEventsRevenue - (priorMonthIncome != null ? priorMonthIncome.EventsIncome : 0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.EventsIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.EventsIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.EventsIncome : 0m) - (priorYearIncome != null ? priorYearIncome.EventsIncome : 0m)))</td>
                                        </tr>
                                    }
                                    @if(accID != "3" && accID != "5")
                                    {
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">Guest Services:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.GuestServicesRevenue)</td>
                                            <td class="snap2">@String.Format("{0:F2}", priorMonthIncome != null ? priorMonthIncome.GuestServicesIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.GuestServicesRevenue - (priorMonthIncome != null ? priorMonthIncome.GuestServicesIncome : 0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.GuestServicesIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.GuestServicesIncome :0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.GuestServicesIncome : 0m) - (priorYearIncome != null ? priorYearIncome.GuestServicesIncome :0m)))</td>
                                        </tr>
                                    }
                                    @if(accID != "3" && accID != "4" && accID != "5")
                                    {
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">Commissions:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.CommissionsRevenue)</td>
                                            <td class="snap2">@String.Format("{0:F2}", priorMonthIncome != null ? priorMonthIncome.CommisionsIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.CommissionsRevenue - (priorMonthIncome != null ? priorMonthIncome.CommisionsIncome : 0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.CommisionsIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.CommisionsIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.CommisionsIncome : 0m) - (priorYearIncome != null ? priorYearIncome.CommisionsIncome :0m))) </td>
                                        </tr>
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">Vendor&nbsp;Decals:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.Addons0370)</td>
                                            <td class="snap2">@String.Format("{0:F2}", priorMonthIncome != null ? priorMonthIncome.Addons0370 : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.Addons0370 - (priorMonthIncome != null ? priorMonthIncome.Addons0370 : 0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.Addons0370 : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.Addons0370 :0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.Addons0370 : 0m) - (priorYearIncome != null ? priorYearIncome.Addons0370 :0m))) </td>
                                        </tr>
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">Park&nbsp;Model&nbsp;Sales:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.ParkModelSalesRevenue + curMonthIncome.Addons0319)</td>
                                            <td class="snap2">@String.Format("{0:F2}", (priorMonthIncome != null ? priorMonthIncome.ParkModelSalesIncome :0m) + (priorMonthIncome != null ? priorMonthIncome.Addons0319 : 0m)) </td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.ParkModelSalesRevenue + curMonthIncome.Addons0319 - (priorMonthIncome != null ? priorMonthIncome.ParkModelSalesIncome - priorMonthIncome.Addons0319 : 0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.ParkModelSalesIncome + curYearIncome.Addons0319 : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.ParkModelSalesIncome + priorYearIncome.Addons0319 :0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.ParkModelSalesIncome + curYearIncome.Addons0319 : 0m) - (priorYearIncome != null ? priorYearIncome.ParkModelSalesIncome - priorYearIncome.Addons0319 :0m))) </td>
                                        </tr>
                                        <tr class="alt">
                                            <td style="background-color: rgb(151, 213, 249)">Miscellaneous:</td>
                                            <td class="snap2">@String.Format("{0:F2}", curMonthIncome.MiscellaneousRevenue)</td>
                                            <td class="snap2">@String.Format("{0:F2}", priorMonthIncome != null ? priorMonthIncome.OtherIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", (curMonthIncome.MiscellaneousRevenue - (priorMonthIncome != null ? priorMonthIncome.OtherIncome :0m)))</td>
                                            <td class="snap2">@String.Format("{0:F2}", curYearIncome != null ? curYearIncome.OtherIncome : 0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", priorYearIncome != null ? priorYearIncome.OtherIncome :0m) </td>
                                            <td class="snap2">@String.Format("{0:F2}", ((curYearIncome != null ? curYearIncome.OtherIncome :0m) - (priorYearIncome != null ? priorYearIncome.OtherIncome :0m)))</td>
                                        </tr>
                                    }
                                    <tr class="alt">
                                        <td style="background-color: rgb(151, 213, 249)">Total:</td>
                                        @{
                                            var cmontot = 0m;
                                            var pmontot = 0m;
                                            var cyrtot = 0m;
                                            var pyrtot = 0m;
                                        }
                                        @if(accID != "3" && accID != "4")
                                        {
                                            cmontot += curMonthIncome.SnackBarNetRevenue + curMonthIncome.ArcadeGamesRevenue + curMonthIncome.CoffeeTrailerRevenue +
                                                        curMonthIncome.ActivitiesEventsRevenue;
                                            pmontot += priorMonthIncome != null ? priorMonthIncome.SnackIncome + priorMonthIncome.ArcadeIncome + priorMonthIncome.CoffeeIncome + priorMonthIncome.EventsIncome : 0m;
                                            cyrtot += curYearIncome != null ? curYearIncome.SnackIncome + curYearIncome.ArcadeIncome + curYearIncome.CoffeeIncome + curYearIncome.EventsIncome : 0m;
                                            pyrtot += priorYearIncome != null ? priorYearIncome.SnackIncome + priorYearIncome.ArcadeIncome + priorYearIncome.CoffeeIncome + priorYearIncome.EventsIncome : 0m;
                                        }
                                        @if(accID != "3" && accID != "5")
                                        {
                                            cmontot += curMonthIncome.StoreNetRevenue + curMonthIncome.PropaneSalesRevenue + curMonthIncome.LaundryRevenue + 
                                                        curMonthIncome.GuestServicesRevenue;
                                            pmontot += priorMonthIncome != null ? priorMonthIncome.StoreIncome + priorMonthIncome.PropaneIncome + priorMonthIncome.LaundryIncome + priorMonthIncome.GuestServicesIncome : 0m;
                                            cyrtot += curYearIncome != null ? curYearIncome.StoreIncome + curYearIncome.PropaneIncome + curYearIncome.LaundryIncome + curYearIncome.GuestServicesIncome : 0m;
                                            pyrtot += priorYearIncome != null ? priorYearIncome.StoreIncome + priorYearIncome.PropaneIncome + priorYearIncome.LaundryIncome + priorYearIncome.GuestServicesIncome :0m;
                                        }
                                        @if(accID != "4" && accID != "5")
                                        {
                                            cmontot += curMonthIncome.TaxableReservationsNetRevenue + curMonthIncome.NoTaxReservationsNetRevenue;
                                            pmontot += priorMonthIncome != null ? priorMonthIncome.ResTaxIncome + priorMonthIncome.ResNoTaxIncome : 0m;
                                            cyrtot += curYearIncome != null ? curYearIncome.ResTaxIncome + curYearIncome.ResNoTaxIncome : 0m;
                                            pyrtot += priorYearIncome != null ? priorYearIncome.ResTaxIncome + priorYearIncome.ResNoTaxIncome : 0m;
                                        }
                                        @if(accID != "3" && accID != "4" && accID != "5")
                                        {
                                            cmontot += curMonthIncome.KayakShackRevenue + curMonthIncome.CommissionsRevenue + curMonthIncome.MiscellaneousRevenue;
                                            pmontot += priorMonthIncome != null ? priorMonthIncome.KayakIncome + priorMonthIncome.CommisionsIncome + priorMonthIncome.OtherIncome : 0m;
                                            cyrtot += curYearIncome != null ? curYearIncome.KayakIncome + curYearIncome.CommisionsIncome + curYearIncome.OtherIncome : 0m;
                                            pyrtot += priorYearIncome != null ? priorYearIncome.KayakIncome + priorYearIncome.CommisionsIncome + priorYearIncome.OtherIncome : 0m;
                                        }
                                        <td class="snap2" style="background-color:yellow">@String.Format("{0:F2}", cmontot)</td>
                                        <td class="snap2">@String.Format("{0:F2}", pmontot)</td>
                                        <td class="snap2" style="background-color:lightgreen">@String.Format("{0:F2}", (cmontot - pmontot))</td>
                                        <td class="snap2" style="background-color:yellow">@String.Format("{0:F2}", cyrtot)</td>
                                        <td class="snap2">@String.Format("{0:F2}", pyrtot)</td>
                                        <td class="snap2" style="background-color:lightgreen">@String.Format("{0:F2}", cyrtot - pyrtot)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        @if(accID != "4" && accID != "5")
        {
            <div class="table-container">
                <div class="myContainer">
                    @if (taxableReservationsListD != null && taxableReservationsListD.Count > 0)
                    {
                        <div class="table-wrapper">
                            <h1 style="text-align:center" class="dep">Deposits Snapshot</h1>
                            <table id="deposits-snapshot-table" class="data-table dep">
                                <thead>


                            <tr>
                                <h4>
                                    <th style="background-color:rgb(63, 62, 62)" class="snapshot" colspan="1" rowspan="2">Deposits <br> Type</th>
                                    <th style="background-color:rgb(63, 62, 62)" class="snapHEAD" colspan="3" class="snap1"> Month-Over-Month To Date</th>
                                    <th style="background-color:rgb(63, 62, 62)" class="snapHEAD" colspan="3" class="snap1"> Year-Over-Year To Date</th>
                                </h4>
                            </tr>
                            <tr>
                                <th class="snap1">@currentMonth
                                </th>
                                <th class="snap1">@lastMonth
                                </th>
                                <th class="snap1">@currentMonth +/-
                                </th>
                                <th class="snap1"> FY @lastFiscalYear
                                </th>
                                <th class="snap1"> FY @twoFiscalYearsAgo
                                </th>
                                <th class="snap1"> @fyChangeHdr</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int j = 0; j < taxableReservationsListD.Count; j++)
                            {
                                var taxableReservationD = taxableReservationsListD[j];
                                int lmildCount = lastMonthIncomeListD != null ? lastMonthIncomeListD.Count : 0;
                                int lyidCount = lastYearIncomeListD != null ? lastYearIncomeListD.Count : 0;
                                int tyidCount = twoYearIncomeListD != null ? twoYearIncomeListD.Count : 0;
                                if(lastMonthIncomeListD == null || lastYearIncomeListD == null || twoYearIncomeListD == null)
                                {
                                    continue; // Skip this iteration if any list is null
                                }
                                var lastMonthIncomeD = j < lmildCount ? lastMonthIncomeListD[j] : null;
                                var lastYearIncomeD = j < lyidCount ? lastYearIncomeListD[j] : null;
                                var twoYearIncomeD = j < tyidCount ? twoYearIncomeListD[j] : null;
                                <tr class="alt">
                                    <td style="background-color: rgb(151, 213, 249)">Site <br> Taken:
                                    </td>
                                    <td class="snap2">@String.Format("{0:F2}", taxableReservationD.SiteDepositsTaken)</td>
                                    <td class="snap2">@String.Format("{0:F2}", lastMonthIncomeD != null ? lastMonthIncomeD.SiteDepositsTaken : 0m) </td>
                                    <td class="snap2">
                                        @String.Format("{0:F2}", (taxableReservationD.SiteDepositsTaken -
                                                    (lastMonthIncomeD != null ? lastMonthIncomeD.SiteDepositsTaken : 0m)))
                                    </td>
                                    <td class="snap2">@String.Format("{0:F2}", lastYearIncomeD != null ? lastYearIncomeD.SiteDepositsTaken : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", twoYearIncomeD != null ? twoYearIncomeD.SiteDepositsTaken : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", ((lastYearIncomeD != null ? lastYearIncomeD.SiteDepositsTaken :0m) -
                                                    (twoYearIncomeD != null ? twoYearIncomeD.SiteDepositsTaken : 0m)))
                                    </td>
                                </tr>
                                <tr class="alt">
                                    <td style="background-color: rgb(151, 213, 249)">Site <br> Applied:
                                    </td>
                                    <td class="snap2">@String.Format("{0:F2}", taxableReservationD.SiteDepositsApplied)</td>
                                    <td class="snap2">@String.Format("{0:F2}", lastMonthIncomeD != null ? lastMonthIncomeD.SiteDepositsApplied : 0m) </td>
                                    <td class="snap2">
                                        @String.Format("{0:F2}", (taxableReservationD.SiteDepositsApplied -
                                                    (lastMonthIncomeD != null ? lastMonthIncomeD.SiteDepositsApplied :0m)))
                                    </td>
                                    <td class="snap2">@String.Format("{0:F2}", lastYearIncomeD != null ? lastYearIncomeD.SiteDepositsApplied : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", twoYearIncomeD != null ? twoYearIncomeD.SiteDepositsApplied : 0m) </td>
                                    <td class="snap2">
                                        @String.Format("{0:F2}", ((lastYearIncomeD != null ? lastYearIncomeD.SiteDepositsApplied : 0m) -
                                                    (twoYearIncomeD != null ? twoYearIncomeD.SiteDepositsApplied : 0m))) </td>
                                </tr>
                                <tr class="alt">
                                    <td style="background-color: rgb(151, 213, 249)">Rental <br> Taken:</td>
                                    <td class="snap2">@String.Format("{0:F2}", taxableReservationD.RentalDepositsTaken)</td>
                                    <td class="snap2">@String.Format("{0:F2}", lastMonthIncomeD != null ? lastMonthIncomeD.RentalDepositsTaken :0m) </td>
                                    <td class="snap2">
                                        @String.Format("{0:F2}", (taxableReservationD.RentalDepositsTaken -
                                                    (lastMonthIncomeD != null ? lastMonthIncomeD.RentalDepositsTaken : 0m)))</td>
                                    <td class="snap2">@String.Format("{0:F2}", lastYearIncomeD != null ? lastYearIncomeD.RentalDepositsTaken : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", twoYearIncomeD != null ? twoYearIncomeD.RentalDepositsTaken : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", ((lastYearIncomeD != null ? lastYearIncomeD.RentalDepositsTaken : 0m) -
                                                    (twoYearIncomeD != null ? twoYearIncomeD.RentalDepositsTaken : 0m)))
                                    </td>
                                </tr>
                                <tr class="alt">
                                    <td style="background-color: rgb(151, 213, 249)">Rental <br> Applied:</td>
                                    <td class="snap2">@String.Format("{0:F2}", taxableReservationD.RentalDepositsApplied)</td>
                                    <td class="snap2">@String.Format("{0:F2}", lastMonthIncomeD != null ? lastMonthIncomeD.RentalDepositsApplied : 0m) </td>
                                    <td class="snap2">
                                        @String.Format("{0:F2}", (taxableReservationD.RentalDepositsApplied -
                                                    (lastMonthIncomeD != null ? lastMonthIncomeD.RentalDepositsApplied : 0m)))
                                    </td>
                                    <td class="snap2">@String.Format("{0:F2}", lastYearIncomeD != null ? lastYearIncomeD.RentalDepositsApplied : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", twoYearIncomeD != null ? twoYearIncomeD.RentalDepositsApplied : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", ((lastYearIncomeD != null ? lastYearIncomeD.RentalDepositsApplied : 0m) -
                                                    (twoYearIncomeD != null ? twoYearIncomeD.RentalDepositsApplied : 0m)))
                                    </td>
                                </tr>
                                <tr class="alt">
                                    <td style="background-color: rgb(151, 213, 249)">Golf <br> Taken:</td>
                                    <td class="snap2">@String.Format("{0:F2}", taxableReservationD.GolfDepositsTaken)</td>
                                    <td class="snap2">@String.Format("{0:F2}", lastMonthIncomeD != null ? lastMonthIncomeD.GolfDepositsTaken : 0m) </td>
                                    <td class="snap2">
                                        @String.Format("{0:F2}", (taxableReservationD.GolfDepositsTaken -
                                                    (lastMonthIncomeD != null ? lastMonthIncomeD.GolfDepositsTaken : 0m)))
                                    </td>
                                    <td class="snap2">@String.Format("{0:F2}", lastYearIncomeD != null ? lastYearIncomeD.GolfDepositsTaken : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", twoYearIncomeD != null ? twoYearIncomeD.GolfDepositsTaken : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", ((lastYearIncomeD != null ? lastYearIncomeD.GolfDepositsTaken : 0m) -
                                                    (twoYearIncomeD != null ? twoYearIncomeD.GolfDepositsTaken : 0m)))
                                    </td>
                                </tr>
                                <tr class="alt">
                                    <td style="background-color: rgb(151, 213, 249)">Golf <br> Applied:</td>
                                    <td class="snap2">@String.Format("{0:F2}", taxableReservationD.GolfDepositsApplied)</td>
                                    <td class="snap2">@String.Format("{0:F2}", lastMonthIncomeD != null ? lastMonthIncomeD.GolfDepositsApplied : 0m) </td>
                                    <td class="snap2">
                                        @String.Format("{0:F2}", (taxableReservationD.GolfDepositsApplied -
                                                    (lastMonthIncomeD != null ? lastMonthIncomeD.GolfDepositsApplied :0m)))
                                    </td>
                                    <td class="snap2">@String.Format("{0:F2}", lastYearIncomeD != null ? lastYearIncomeD.GolfDepositsApplied : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", twoYearIncomeD != null ? twoYearIncomeD.GolfDepositsApplied : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", ((lastYearIncomeD != null ? lastYearIncomeD.GolfDepositsApplied : 0m) -
                                                    (twoYearIncomeD != null ? twoYearIncomeD.GolfDepositsApplied : 0m)))
                                    </td>
                                </tr>
                                <tr class="alt">
                                    <td style="background-color: rgb(151, 213, 249)">Vouchers<br> Purchased:</td>
                                    <td class="snap2">@String.Format("{0:F2}", taxableReservationD.VouchersPurchased)</td>
                                    <td class="snap2">@String.Format("{0:F2}", lastMonthIncomeD != null ? lastMonthIncomeD.VouchersPurchased : 0m) </td>
                                    <td class="snap2">
                                        @String.Format("{0:F2}", (taxableReservationD.VouchersPurchased -
                                                    (lastMonthIncomeD != null ? lastMonthIncomeD.VouchersPurchased : 0m)))
                                    </td>
                                    <td class="snap2">@String.Format("{0:F2}", lastYearIncomeD != null ? lastYearIncomeD.VouchersPurchased : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", twoYearIncomeD != null ? twoYearIncomeD.VouchersPurchased : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", (lastYearIncomeD != null ? lastYearIncomeD.VouchersPurchased : 0m) -
                                                    (twoYearIncomeD != null ? twoYearIncomeD.VouchersPurchased : 0m)))
                                    </td>
                                </tr>
                                <tr class="alt">
                                    <td style="background-color: rgb(151, 213, 249)">Vouchers<br> Applied:</td>
                                    <td class="snap2">@String.Format("{0:F2}", taxableReservationD.VouchersRedeemed)</td>
                                    <td class="snap2">@String.Format("{0:F2}", lastMonthIncomeD != null ? lastMonthIncomeD.VouchersRedeemed : 0m) </td>
                                    <td class="snap2">
                                        @String.Format("{0:F2}", (taxableReservationD.VouchersRedeemed -
                                                    (lastMonthIncomeD != null ? lastMonthIncomeD.VouchersRedeemed : 0m)))
                                    </td>
                                    <td class="snap2">@String.Format("{0:F2}", lastYearIncomeD != null ? lastYearIncomeD.VouchersRedeemed : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", twoYearIncomeD != null ? twoYearIncomeD.VouchersRedeemed : 0m) </td>
                                    <td class="snap2">@String.Format("{0:F2}", ((lastYearIncomeD != null ? lastYearIncomeD.VouchersRedeemed : 0m )-
                                                    (twoYearIncomeD != null ? twoYearIncomeD.VouchersRedeemed : 0m)))
                                    </td>
                                </tr>
                                <tr class="alt">
                                    <td style="background-color: rgb(151, 213, 249)">Total:</td>
                                    <td class="snap2" style="background-color:yellow">
                                        @String.Format("{0:F2}",
                                                    (taxableReservationD.SiteDepositsTaken - taxableReservationD.SiteDepositsApplied + taxableReservationD.RentalDepositsTaken - taxableReservationD.RentalDepositsApplied + taxableReservationD.GolfDepositsTaken - taxableReservationD.GolfDepositsApplied + taxableReservationD.VouchersPurchased - taxableReservationD.VouchersRedeemed))
                                    </td>
                                    <td class="snap2">
                                        @String.Format("{0:F2}",
                                                    (lastMonthIncomeD != null ? lastMonthIncomeD.SiteDepositsTaken - lastMonthIncomeD.SiteDepositsApplied + lastMonthIncomeD.RentalDepositsTaken - lastMonthIncomeD.RentalDepositsApplied + lastMonthIncomeD.GolfDepositsTaken - lastMonthIncomeD.GolfDepositsApplied + lastMonthIncomeD.VouchersPurchased - lastMonthIncomeD.VouchersRedeemed : 0m))
                                    </td>
                                    <td class="snap2">
                                        @String.Format("{0:F2}", ((taxableReservationD.SiteDepositsTaken - (lastMonthIncomeD != null ? lastMonthIncomeD.SiteDepositsTaken : 0m)) - 
                                                                  (taxableReservationD.SiteDepositsApplied - (lastMonthIncomeD != null ? lastMonthIncomeD.SiteDepositsApplied : 0m)) +
                                                                  (taxableReservationD.RentalDepositsTaken - (lastMonthIncomeD != null ? lastMonthIncomeD.RentalDepositsTaken : 0m)) -
                                                                  (taxableReservationD.RentalDepositsApplied - (lastMonthIncomeD != null ? lastMonthIncomeD.RentalDepositsApplied : 0m)) +
                                                                  (taxableReservationD.GolfDepositsTaken - (lastMonthIncomeD != null ? lastMonthIncomeD.GolfDepositsTaken : 0m)) -
                                                                  (taxableReservationD.GolfDepositsApplied - (lastMonthIncomeD != null ? lastMonthIncomeD.GolfDepositsApplied : 0m)) +
                                                                  (taxableReservationD.VouchersPurchased - (lastMonthIncomeD != null ? lastMonthIncomeD.VouchersPurchased : 0m)) -
                                                                  (taxableReservationD.VouchersRedeemed - (lastMonthIncomeD != null ? lastMonthIncomeD.VouchersRedeemed : 0m))))
                                    </td>
                                    <td class="snap2" style="background-color:yellow">
                                        @String.Format("{0:F2}",
                                                    (lastYearIncomeD != null ? lastYearIncomeD.SiteDepositsTaken - lastYearIncomeD.SiteDepositsApplied + lastYearIncomeD.RentalDepositsTaken - lastYearIncomeD.RentalDepositsApplied + lastYearIncomeD.GolfDepositsTaken - lastYearIncomeD.GolfDepositsApplied + lastYearIncomeD.VouchersPurchased - lastYearIncomeD.VouchersRedeemed : 0m))
                                    </td>
                                    <td class="snap2">
                                        @String.Format("{0:F2}",
                                                    (twoYearIncomeD != null ? twoYearIncomeD.SiteDepositsTaken - twoYearIncomeD.SiteDepositsApplied + twoYearIncomeD.RentalDepositsTaken - twoYearIncomeD.RentalDepositsApplied + twoYearIncomeD.GolfDepositsTaken - twoYearIncomeD.GolfDepositsApplied + twoYearIncomeD.VouchersPurchased - twoYearIncomeD.VouchersRedeemed : 0m))
                                    </td>
                                    <td class="snap2" style="background-color:lightgreen">
                                        @String.Format("{0:F2}", ((lastYearIncomeD != null ? lastYearIncomeD.SiteDepositsTaken : 0m) - (twoYearIncomeD != null ? twoYearIncomeD.SiteDepositsTaken : 0m)) - 
                                                                  ((lastYearIncomeD != null ? lastYearIncomeD.SiteDepositsApplied : 0m) - (twoYearIncomeD != null ? twoYearIncomeD.SiteDepositsApplied : 0m)) + 
                                                                  ((lastYearIncomeD != null ? lastYearIncomeD.RentalDepositsTaken : 0m) - (twoYearIncomeD != null ? twoYearIncomeD.RentalDepositsTaken : 0m)) - 
                                                                  ((lastYearIncomeD != null ? lastYearIncomeD.RentalDepositsApplied : 0m) - (twoYearIncomeD != null ? twoYearIncomeD.RentalDepositsApplied : 0m)) + 
                                                                  ((lastYearIncomeD != null ? lastYearIncomeD.GolfDepositsTaken : 0m) - (twoYearIncomeD != null ? twoYearIncomeD.GolfDepositsTaken : 0m)) - 
                                                                  ((lastYearIncomeD != null ? lastYearIncomeD.GolfDepositsApplied : 0m) - (twoYearIncomeD != null ? twoYearIncomeD.GolfDepositsApplied : 0m)) + 
                                                                  ((lastYearIncomeD != null ? lastYearIncomeD.VouchersPurchased : 0m) - (twoYearIncomeD != null ? twoYearIncomeD.VouchersPurchased : 0m)) - 
                                                                  ((lastYearIncomeD != null ? lastYearIncomeD.VouchersRedeemed : 0m) - (twoYearIncomeD != null ? twoYearIncomeD.VouchersRedeemed : 0m))))
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>} 
        </div>
            </div>
        }
    </div>
}
</body>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var tables = document.querySelectorAll('.data-table');
        function formatNumberWithCommas(number) {
            return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }
        tables.forEach(function (table) {
            var cells = table.querySelectorAll('tbody td');
            cells.forEach(function (cell) {
                var amount = parseFloat(cell.textContent);
                if (!isNaN(amount)) {
                    if (amount < 0) {
                        cell.classList.add('negative-value');
                        cell.textContent = '(' + formatNumberWithCommas(Math.abs(amount).toFixed(2)) + ')';
                    } else if (amount == 0) {
                        cell.textContent = '';
                    } else {
                        cell.textContent = formatNumberWithCommas(amount.toFixed(2));
                    }
                }
            });
        });
    });
</script>