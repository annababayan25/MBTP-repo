@using System.Data
@using MBTP.Controllers
@using MBTP.Retrieval
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

@{
 DateTime startDate = (DateTime)ViewBag.FiscalYearStartDate;
    string? fiscalYear = Context.Session.GetString("FiscalYear");
    string? isCurrentFiscalYear = Context.Session.GetString("IsCurrentFiscalYear");
    DateTime currentDate = DateTime.Now;
    int monthIndex = 0;
    int dataRecordRow = 0;

    decimal totalSDTaken = 0;
    decimal totalSDApplied = 0;
    decimal totalSDMR = 0;
    decimal totalNetChange1 = 0;
    decimal totalRDTaken = 0;
    decimal totalRDApplied = 0;
    decimal totalRDMR = 0;
    decimal totalNetChange2 = 0;
    decimal totalGDTaken = 0;
    decimal totalGDApplied = 0;
    decimal totalGDMR = 0;
    decimal totalNetChange3 = 0;
    decimal totalPurchased = 0;
    decimal totalRedeemedSite = 0;
    decimal totalRedeemedRent = 0;
    decimal totalRedeemedSto = 0;
    decimal totalNetChange4 = 0;
}
<div class='head-container'>
    <h1>Month-By-Month Information for Fiscal Year @fiscalYear</h1>
    <p>&nbsp;</p>
    <a class="pdfButton" asp-area="" asp-controller="FDB" asp-action="Yearly">Back to yearly</a>
    <p>&nbsp;</p>
    <p>single click a specific month for its daily breakdown</p>
</div>

<body>
@if (Model is not null && Model.Tables[0].Rows.Count > 0)
{
<div class="table-responsive" style="max-height: 75vh; overflow-y: auto;">
<table id="monthly-table" class="breakdown clickable-tableR" style="width:240px; border: none;">
    <tr>
        <th class="breakdownBigTitle" colspan="18">Reservations Deposits</th>
    </tr>
    <tr>
        <th class="breakdownMonthScrolling"></th>
        <th class="breakdownTaxBig" colspan="4">Campsites</th>
        <th class="breakdownTaxBig" colspan="4">Rentals</th>
        <th class="breakdownTaxBig" colspan="4">Golf Carts</th>
        <th class="breakdownTaxBig" colspan="5">Gift Vouchers</th>
    </tr>
    <tr>
        <th class="breakdownMonthScrolling"></th>
        <th class="breakdownTitle" colspan="3">281</th>
                <th class="breakdownTotalsHead" rowspan="2">Net Change</th>
        <th class="breakdownTitle" colspan="3">283</th>
                <th class="breakdownTotalsHead" rowspan="2">Net Change</th>
        <th class="breakdownTitle" colspan="3">262</th>
                <th class="breakdownTotalsHead" rowspan="2">Net Change</th>
        <th class="breakdownTitle" colspan="4">287</th>
                <th class="breakdownTotalsHead" rowspan="2">Net Change</th>
    </tr>
    <tr>
        <th class="breakdownMonthScrollingBottom">Month</th>
        <th class="breakdownTitle">Deposits Taken</th>
        <th class="breakdownTitle">Deposits Applied</th>
        <th class="breakdownRefTitle">Manual Refunds Generated</th>
        <th class="breakdownTitle">Rentals Taken</th>
        <th class="breakdownTitle">Rentals Applied</th>
        <th class="breakdownRefTitle">Manual Refunds Generated</th>
        <th class="breakdownTitle">Deposits Taken</th>
        <th class="breakdownTitle">Deposits Applied</th>
        <th class="breakdownRefTitle">Manual Refunds Generated</th>
        <th class="breakdownTitle">Purchased</th>
        <th class="breakdownTitle">Redeemed For Sites</th>
        <th class="breakdownTitle">Redeemed For Rentals</th>
        <th class="breakdownTitle">Redeemed For Storage</th>

   </tr>
@foreach (DataRow row in Model!.Tables[0].Rows)
{
        dataRecordRow++;
        var breakdownMonthClass = new System.Text.StringBuilder("breakdownMonth");
        var breakdownDataClass = new System.Text.StringBuilder("breakdownData");
        var breakdownRefClass = new System.Text.StringBuilder("breakdownRef");
        var breakdownTotalsClass = new System.Text.StringBuilder("breakdownTotals");
        var breakdownTaxClass = new System.Text.StringBuilder("breakdownTax");
        if(dataRecordRow == 1)
        {
            breakdownMonthClass.Remove(0, "breakdownMonth".Length).Append("breakdownMonthTop");
            breakdownDataClass.Remove(0, "breakdownData".Length).Append("breakdownDataTop");
            breakdownRefClass.Remove(0, "breakdownRef".Length).Append("breakdownRefTop");
            breakdownTotalsClass.Remove(0, "breakdownTotals".Length).Append("breakdownTotalsTop");
            breakdownTaxClass.Remove(0, "breakdownTax".Length).Append("breakdownTaxTop");
        }
        breakdownMonthClass.ToString();
        breakdownDataClass.ToString();
        breakdownRefClass.ToString();
        breakdownTotalsClass.ToString();
        breakdownTaxClass.ToString();
    var monthDate = startDate.AddMonths(monthIndex);
    var month = startDate.AddMonths(monthIndex).ToString("MMMM");

    var SDT = ((decimal)row["SitesTaken"]+(decimal)row["SitesTakenFuture"]);
    var SDA = (decimal)row["SitesApplied"];
    var SDMRG = (decimal)row["SiteDepMRG"];
    var RDT = (decimal)row["RentalTaken"]+(decimal)row["RentalTakenFuture"];
    var RDA = (decimal)row["RentalApplied"];
    var RDMRG = (decimal)row["RentalDerpMRG"];
    var GDT = (decimal)row["GolfTaken"]+(decimal)row["GolfTakenFuture"];
    var GDA = (decimal)row["GolfApplied"];
    var GDMRG = (decimal)row["GolfDepMRG"];
    var VP = (decimal)row["VouchersPurch"];
    var VRS = (decimal)row["VouchersRedSite"];
    var VRR = (decimal)row["VouchersRedRental"];
    var VRSto = (decimal)row["VouchersRedStorage"];
    var netChange1 = SDT - (SDA + SDMRG);
    var netChange2 = RDT - (RDA + RDMRG);
    var netChange3 = GDT - (GDA + GDMRG);
    var netChange4 = VP - VRS - VRR - VRSto;


    totalSDTaken += SDT;
     totalSDApplied += SDA;
     totalSDMR += SDMRG;
     totalNetChange1 += netChange1;
     totalRDTaken += RDT;
     totalRDApplied += RDA;
     totalRDMR += RDMRG;
     totalNetChange2 += netChange2 ;
     totalGDTaken += GDT;
     totalGDApplied += GDA;
    totalGDMR += GDMRG;
     totalNetChange3 += netChange3 ;
     totalPurchased += VP;
     totalRedeemedSite += VRS;
     totalRedeemedRent += VRR;
     totalRedeemedSto += VRSto;
     totalNetChange4 += netChange4;
    

    <tr class="colorAlt" data-month="@monthDate.Month" data-year="@monthDate.Year">
        <td class="@breakdownMonthClass">@month</td>
        <td class="@breakdownDataClass">@(@SDT != 0 ? String.Format("{0:c2}", @SDT) : "")</td>
        <td class="@breakdownDataClass">@(@SDA != 0 ? String.Format("{0:c2}", @SDA) : "")</td>
        <td class="@breakdownRefClass">@(@SDMRG != 0 ? String.Format("{0:c2}", @SDMRG) : "")</td>
        <td class="@breakdownTotalsClass">@(@netChange1 != 0 ? String.Format("{0:c2}", @netChange1) : "")</td>
        <td class="@breakdownDataClass">@(@RDT != 0 ? String.Format("{0:c2}", @RDT) : "")</td>
        <td class="@breakdownDataClass">@(@RDA != 0 ? String.Format("{0:c2}", @RDA) : "")</td>
        <td class="@breakdownRefClass">@(@RDMRG != 0 ? String.Format("{0:c2}", @RDMRG) : "")</td>
        <td class="@breakdownTotalsClass">@(@netChange2 != 0 ? String.Format("{0:c2}", @netChange2) : "")</td>
        <td class="@breakdownDataClass">@(@GDT != 0 ? String.Format("{0:c2}", @GDT) : "")</td>
        <td class="@breakdownDataClass">@(@GDA != 0 ? String.Format("{0:c2}", @GDA) : "")</td>
        <td class="@breakdownRefClass">@(@GDMRG != 0 ? String.Format("{0:c2}", @GDMRG) : "")</td>
        <td class="@breakdownTotalsClass">@(@netChange3 != 0 ? String.Format("{0:c2}", @netChange3) : "")</td>
        <td class="@breakdownDataClass">@(@VP != 0 ? String.Format("{0:c2}", @VP) : "")</td>
        <td class="@breakdownDataClass">@(@VRS != 0 ? String.Format("{0:c2}", @VRS) : "")</td>
        <td class="@breakdownDataClass">@(@VRR != 0 ? String.Format("{0:c2}", @VRR) : "")</td>
        <td class="@breakdownDataClass">@(@VRSto != 0 ? String.Format("{0:c2}", @VRSto) : "")</td>
        <td class="@breakdownTotalsClass">@(@netChange4 != 0 ? String.Format("{0:c2}", @netChange4) : "")</td>
    </tr>
    monthIndex++;
}
<tr>
    <td class ="breakdownTotalsScrolling" style="border-bottom: 1px solid black;">Totals:</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalSDTaken != 0 ? String.Format("{0:c2}", totalSDTaken) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalSDApplied != 0 ? String.Format("{0:c2}", totalSDApplied) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalSDMR != 0 ? String.Format("{0:c2}", totalSDMR) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalNetChange1 != 0 ? String.Format("{0:c2}", totalNetChange1) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalRDTaken != 0 ? String.Format("{0:c2}", totalRDTaken) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalRDApplied != 0 ? String.Format("{0:c2}", totalRDApplied) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalRDMR != 0 ? String.Format("{0:c2}", totalRDMR) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalNetChange2 != 0 ? String.Format("{0:c2}", totalNetChange2) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalGDTaken != 0 ? String.Format("{0:c2}", totalGDTaken) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalGDApplied != 0 ? String.Format("{0:c2}", totalGDApplied) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalGDMR != 0 ? String.Format("{0:c2}", totalGDMR) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalNetChange3 != 0 ? String.Format("{0:c2}", totalNetChange3) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalPurchased != 0 ? String.Format("{0:c2}", totalPurchased) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalRedeemedSite != 0 ? String.Format("{0:c2}", totalRedeemedSite) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalRedeemedRent != 0 ? String.Format("{0:c2}", totalRedeemedRent) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalRedeemedSto != 0 ? String.Format("{0:c2}", totalRedeemedSto) : "")</td>
    <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalNetChange4 != 0 ? String.Format("{0:c2}", totalNetChange4) : "")</td>
</tr>

</table>
</div>
}
</body>

<script>
$(document).ready(function () {
    $("#monthly-table").on("click", "tr", function () {
        var year = $(this).data("year");
        var month = $(this).data("month");
        var date = new Date(year, month - 1, 1); // JavaScript months are 0-based
        var url = `/FDB/DailyBreakdownR?date=${date.toISOString()}&whichMonth=None`;
        console.log('single-click detected on table row. URL:', url);
        if (url) {
            console.log('Navigating to:', url);
            window.location.href = url;
        } else {
            console.error('URL is undefined');
        }
    });
});
</script>
</html>
