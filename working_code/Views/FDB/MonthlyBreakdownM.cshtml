@using System.Data
@using MBTP.Controllers
@using MBTP.Retrieval
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

@{
    DateTime startDate = (DateTime)ViewBag.FiscalYearStartDate;
    string? fiscalYear = Context.Session.GetString("FiscalYear");
    string? isCurrentFiscalYear = Context.Session.GetString("IsCurrentFiscalYear");
    DateTime currentDate = DateTime.Now;
    var accID = User.FindFirst("AccID")?.Value;
    int monthIndex = 0;
    int dataRecordRow = 0;

    decimal totalCATV = 0;
    decimal totalGuestServices = 0;
    decimal totalLeasedConcessions = 0;
    decimal totalOtherM = 0;
    decimal totalAtSitePropane = 0;
    decimal totalPropaneStation = 0;
    decimal totalLaundry = 0;
    decimal totalStoreEvents = 0;
    decimal totalFrontEvents = 0;
    decimal totalVendorDecals = 0;
    decimal totalParkModelSales = 0;
    decimal totalSupplementalO = 0;
    decimal totalSupplementalS = 0;
    decimal totalTotals = 0;
}
<div class='head-container'>
    <h1>Month-By-Month Information for Fiscal Year @fiscalYear</h1>
    <p>&nbsp;</p>
    <a class="pdfButton" asp-area="" asp-controller="FDB" asp-action="Yearly">Back to yearly</a>
    <p>&nbsp;</p>
    <p>single click a specific month for its daily breakdown</p>
</div>

<body>
@if (Model is not null && Model.Tables[0].Rows.Count > 0)
{
<div class="table-responsive " style="max-height: 75vh; overflow-y: auto;"> 
    <table id="monthly-table" class="breakdown clickable-tableM" style="width:240px; border: none;">
        <tr>
            @if(accID == "4")
            {
                <th class="breakdownBigTitle" colspan="6">Miscellaneous Income</th>
            }
            else
            {
                <th class="breakdownBigTitle" colspan="15">Miscellaneous Income</th>
            }
        </tr>
        <tr>
            <th class="breakdownMonthScrolling"></th>
            @if(accID == "4")
            {
                <th class="breakdownTaxBig">Commissions</th>
                <th class="breakdownTaxBig" colspan="3">Other</th>
            }
            else
            {
                <th class="breakdownTaxBig" colspan="4">Commissions</th>
                <th class="breakdownTaxBig" colspan="9">Other</th>
            }
            <th class="breakdownTotalsHead" rowspan="3">Total</th> 
        </tr>
        <tr>
            <th class="breakdownMonthScrolling"></th>
            @if(accID != "4")
            {
                <th class="breakdownTitle">384</th>
            }
            <th class="breakdownTitle">392</th>
            @if(accID != "4")
            {
                <th class="breakdownTitle">352</th>
                <th class="breakdownTitle">393</th>
            }
            <th class="breakdownTitle">320</th>
            <th class="breakdownTitle">321</th>
            <th class="breakdownTitle">328</th>
            @if(accID != "4")
            {
                <th class="breakdownTitle" colspan="2">359</th>
                <th class="breakdownTitle">370</th>
                <th class="breakdownTitle">380</th>
                <th class="breakdownTitle" rowspan="2">Other Office Income</th>
                <th class="breakdownTitle" rowspan="2">Supplemental Income</th>
            }
        </tr>
        <tr>
            <th class="breakdownMonthScrollingBottom">Month</th>
            @if(accID != "4")
            {
                <th class="breakdownTitle">CATV</th>
            }
            <th class="breakdownTitle">Guest Services</th>
            @if(accID != "4")
            {
                <th class="breakdownTitle">Leased Concessions</th>
                <th class="breakdownTitle">Other</th>
            }
            <th class="breakdownTitle">At-Site Propane</th>
            <th class="breakdownTitle">Propane Station</th>
            <th class="breakdownTitle">Laundry</th>
            @if(accID != "4")
            {
                <th class="breakdownTitle">Activities / Store&nbsp;Events</th>
                <th class="breakdownTitle">Office Events</th>
                <th class="breakdownTitle">Vendor Decals</th>
                <th class="breakdownTitle">Park Model Sales</th>
            }
        </tr>
        @foreach (DataRow row in Model!.Tables[0].Rows)
        {
        dataRecordRow++;
        var breakdownMonthClass = new System.Text.StringBuilder("breakdownMonth");
        var breakdownDataClass = new System.Text.StringBuilder("breakdownData");
        var breakdownTotalsClass = new System.Text.StringBuilder("breakdownTotals");
        var breakdownTaxClass = new System.Text.StringBuilder("breakdownTax");
        if(dataRecordRow == 1)
        {
            breakdownMonthClass.Remove(0, "breakdownMonth".Length).Append("breakdownMonthTop");
            breakdownDataClass.Remove(0, "breakdownData".Length).Append("breakdownDataTop");
            breakdownTotalsClass.Remove(0, "breakdownTotals".Length).Append("breakdownTotalsTop");
            breakdownTaxClass.Remove(0, "breakdownTax".Length).Append("breakdownTaxTop");
        }
        breakdownMonthClass.ToString();
        breakdownDataClass.ToString();
        breakdownTotalsClass.ToString();
        breakdownTaxClass.ToString();
            var monthDate = startDate.AddMonths(monthIndex);
            var month = startDate.AddMonths(monthIndex).ToString("MMMM");
            var CATV = (decimal)row["CATV"];
            var GuestServices = (decimal)row["GuestServices"];
            var LeasedConcessions = (decimal)row["LeasedConcessions"];
            var OtherM = (decimal)row["OtherM"];
            var AtSitePropane = (decimal)row["AtSitePropane"];
            var PropaneStation = (decimal)row["PropaneStation"];
            var Laundry = (decimal)row["Laundry"];
            var StoreEvents = (decimal)row["StoreEvents"];
            var FrontEvents = (decimal)row["FrontEvents"];
            var VendorDecals = (decimal)row["VendorDecals"];
            var ParkModelSales = (decimal)row["ParkModelSales"];
            var SupplementalO = (decimal)row["SupplementalO"];
            var SupplementalS = (decimal)row["SupplementalS"];
            decimal totals = 0.0m;
            @if(accID == "4")
            {
                totals = (decimal)row["GuestServices"]+(decimal)row["AtSitePropane"]+(decimal)row["PropaneStation"]+(decimal)row["Laundry"];
            }
            else
            {
                totals = (decimal)row["CATV"]+(decimal)row["GuestServices"]+(decimal)row["LeasedConcessions"]+(decimal)row["OtherM"]+(decimal)row["AtSitePropane"]+(decimal)row["PropaneStation"]+(decimal)row["Laundry"]+(decimal)row["StoreEvents"]+(decimal)row["FrontEvents"]+(decimal)row["VendorDecals"]+(decimal)row["ParkModelSales"]+(decimal)row["SupplementalO"]+(decimal)row["SupplementalS"];
            }
            totalCATV += CATV;
            totalGuestServices += GuestServices;
            totalLeasedConcessions += LeasedConcessions;
            totalOtherM += OtherM;
            totalAtSitePropane += AtSitePropane;
            totalPropaneStation += PropaneStation;
            totalLaundry += Laundry;
            totalStoreEvents += StoreEvents;
            totalFrontEvents += FrontEvents;
            totalVendorDecals += VendorDecals;
            totalParkModelSales += ParkModelSales;
            totalSupplementalO += SupplementalO;
            totalSupplementalS += SupplementalS;
            totalTotals += totals;
            <tr class="colorAlt" data-month="@monthDate.Month" data-year="@monthDate.Year">
                <td class="@breakdownMonthClass">@month</td>
                @if(accID != "4")
                {
                    <td class="@breakdownDataClass">@(@CATV != 0.00m ? String.Format("{0:c2}", @CATV) : "")</td>
                }
                    <td class="@breakdownDataClass">@(@GuestServices != 0.00m ? String.Format("{0:c2}", @GuestServices) : "")</td>
                @if(accID != "4")
                {
                    <td class="@breakdownDataClass">@(@LeasedConcessions != 0.00m ? String.Format("{0:c2}", @LeasedConcessions) : "")</td>
                    <td class="@breakdownDataClass">@(@OtherM != 0.00m ? String.Format("{0:c2}", @OtherM) : "")</td>
                }
                    <td class="@breakdownDataClass">@(@AtSitePropane != 0.00m ? String.Format("{0:c2}", @AtSitePropane) : "")</td>
                    <td class="@breakdownDataClass">@(@PropaneStation != 0.00m ? String.Format("{0:c2}", @PropaneStation) : "")</td>
                    <td class="@breakdownDataClass">@(@Laundry != 0.00m ? String.Format("{0:c2}", @Laundry) : "")</td>
                @if(accID != "4")
                {
                    <td class="@breakdownDataClass">@(@StoreEvents != 0.00m ? String.Format("{0:c2}", @StoreEvents) : "")</td>
                    <td class="@breakdownDataClass">@(@FrontEvents != 0.00m ? String.Format("{0:c2}", @FrontEvents) : "")</td>
                    <td class="@breakdownDataClass">@(@VendorDecals != 0.00m ? String.Format("{0:c2}", @VendorDecals) : "")</td>
                    <td class="@breakdownDataClass">@(@ParkModelSales != 0.00m ? String.Format("{0:c2}", @ParkModelSales) : "")</td>
                    <td class="@breakdownDataClass">@(@SupplementalO != 0.00m ? String.Format("{0:c2}", @SupplementalO) : "")</td>
                    <td class="@breakdownDataClass">@(@SupplementalS != 0.00m ? String.Format("{0:c2}", @SupplementalS) : "")</td>
                }
                <td class="@breakdownTotalsClass">@(@totals != 0.00m ? String.Format("{0:c2}", @totals) : "")</td>
            </tr>
            monthIndex ++;
        }
        <tr>
            <td class="breakdownTotalsScrolling" style="border-bottom: 1px solid black;">Totals:</td>
            @if(accID != "4")
            {
                <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalCATV != 0.00m ? String.Format("{0:c2}", totalCATV) : "")</td>
            }
            <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalGuestServices != 0.00m ? String.Format("{0:c2}", totalGuestServices) : "")</td>
            @if(accID != "4")
            {
                <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalLeasedConcessions != 0.00m ? String.Format("{0:c2}", totalLeasedConcessions) : "")</td>
                <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalOtherM != 0.00m ? String.Format("{0:c2}", totalOtherM) : "")</td>
            }
            <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalAtSitePropane != 0.00m ? String.Format("{0:c2}", totalAtSitePropane) : "")</td>
            <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalPropaneStation != 0.00m ? String.Format("{0:c2}", totalPropaneStation) : "")</td>
            <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalLaundry != 0.00m ? String.Format("{0:c2}", totalLaundry) : "")</td>
            @if(accID != "4")
            {
                <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalStoreEvents != 0.00m ? String.Format("{0:c2}", totalStoreEvents) : "")</td>
                <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalFrontEvents != 0.00m ? String.Format("{0:c2}", totalFrontEvents) : "")</td>
                <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalVendorDecals != 0.00m ? String.Format("{0:c2}", totalVendorDecals) : "")</td>
                <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalParkModelSales != 0.00m ? String.Format("{0:c2}", totalParkModelSales) : "")</td>
                <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalSupplementalO != 0.00m ? String.Format("{0:c2}", totalSupplementalO) : "")</td>
                <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalSupplementalS != 0.00m ? String.Format("{0:c2}", totalSupplementalS) : "")</td>
            }
            <td class="breakdownTotals2" style="border-bottom: 1px solid black;">@(@totalTotals != 0.00m ? String.Format("{0:c2}", totalTotals) : "")</td>
        </tr>
    </table>
    </div>
}
</body>

<script>
$(document).ready(function () {
    $("#monthly-table").on("click", "tr", function () {
        var year = $(this).data("year");
        var month = $(this).data("month");
        var date = new Date(year, month - 1, 1); // JavaScript months are 0-based
        var url = `/FDB/DailyBreakdownM?date=${date.toISOString()}&whichMonth=None`;
        console.log('single-click detected on table row. URL:', url);
        if (url) {
            console.log('Navigating to:', url);
            window.location.href = url;
        } else {
            console.error('URL is undefined');
        }
    });
});
</script>
