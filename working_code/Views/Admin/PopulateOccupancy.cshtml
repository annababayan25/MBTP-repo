@using System.Data
@model DataSet

@{
    ViewData["Title"] = "Populate Occupancy Report";
    var SelectedDay = ViewBag.SelectedDay as DateTime?;
    var titleDate = SelectedDay.HasValue
        ? $"for {SelectedDay.Value.ToString("dddd, MMMM dd, yyyy")}"
        : "";
}

<link rel="stylesheet" href="~/css/reports.css" />

<!DOCTYPE html>
<html lang="en">

<h2 style="text-align: center;">
    Daily Occupancy Report @titleDate
</h2>

<head>
    <meta charset="UTF-8" name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Occupancy Report</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>

<div class="loading-overlay" id="loadingOverlay">
    <i class="fas fa-spinner fa-spin spinner"></i>
</div>


<form method="get" asp-action="PopulateOccupancy" class="navigation-container">
    <label for="dayPicker">Select Day:</label>
    <input type="text" id="dayPicker" name="day" value="@SelectedDay?.ToString("yyyy-MM-dd")">

    <button type="submit" class="btn btn-success small-btn" formaction="@Url.Action("ExportOccupancyToExcel")" formtarget="_blank">
        <i class="fas fa-file-excel"></i> Export
    </button>
</form>


@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

@if (Model != null && Model.Tables.Count > 0 && Model.Tables[0].Rows.Count > 0)
{
    <div class="tables-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Sites</th>
                        <th>Nights Available</th>
                        <th>Bookings</th>
                        <th>BookingLength</th>
                        <th>Projected Earnings (Tax Inc)</th>
                        <th>Projected Earnings (Tax Exc)</th>
                        <th>Projected Earnings Per Booking (Tax Inc)</th>
                        <th>Projected Earnings Per Booking (Tax Exc)</th>
                        <th>Projected Earnings Per Occupancy (Tax Inc)</th>
                        <th>Projected Earnings Per Occupancy (Tax Exc)</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (DataRow row in Model!.Tables[0].Rows)
                {
                    <tr>
                        <td>@row["OccupancyDate"]</td>
                        <td>@row["Category"]</td>
                        <td>@row["Sites"]</td>
                        <td>@row["NightsAvailable"]</td>
                        <td>@row["Bookings"]</td>
                        <td>@row["BookingLength"]</td>
                        <td>@row["ProjEarnings_TaxInc"]</td>
                        <td>@(row["ProjEarnings_TaxExc"] != DBNull.Value ? String.Format("{0:#,##0.00;(#,##0.00);0.00}", row["ProjEarnings_TaxExc"]) : "-") </td>
                        <td>@(row["ProjEarnings_PerBooking_TaxInc"] != DBNull.Value ? String.Format("{0:#,##0.00;(#,##0.00);0.00}", row["ProjEarnings_PerBooking_TaxInc"]) : "-")</td>
                        <td>@(row["ProjEarnings_PerBooking_TaxExc"] != DBNull.Value ? String.Format("{0:#,##0.00;(#,##0.00);0.00}", row["ProjEarnings_PerBooking_TaxExc"]) : "-")</td>
                        <td>@(row["ProjEarnings_PerOccNight_TaxInc"] != DBNull.Value ? String.Format("{0:#,##0.00;(#,##0.00);0.00}", row["ProjEarnings_PerOccNight_TaxInc"]) : "-")</td>
                        <td>@(row["ProjEarnings_PerOccNight_TaxExc"] != DBNull.Value ? String.Format("{0:#,##0.00;(#,##0.00);0.00}", row["ProjEarnings_PerOccNight_TaxExc"]) : "-")</td>
                </tr>
                }
                </tbody>
            </table>
        </div>
}
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/js/all.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function() {
    const loadingOverlay = document.getElementById('loadingOverlay');
    const form = document.querySelector('form');

    form.addEventListener('submit', function (e) {
        const submitter = e.submitter;

        if (submitter && submitter.formTarget === '_blank') {
            return
        }
        sessionStorage.setItem('loading', 'true');
        loadingOverlay.style.display = 'flex';
    });

    flatpickr("#dayPicker", {
        dateFormat: "Y-m-d",
        maxDate: "today",
        defaultDate: "@(SelectedDay.HasValue ? SelectedDay.Value.ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd"))",
        onChange: function(selectedDates, dateStr, instance) {
            var newUrl = new URL(window.location.href);
            newUrl.searchParams.set("day", dateStr); 
            sessionStorage.setItem('loading', 'true');
            loadingOverlay.style.display = 'flex';
            window.location.href = newUrl.toString();
        }
    });

    window.addEventListener('load', function() {
        loadingOverlay.style.display = 'none';
        sessionStorage.removeItem('loading');
    });

    window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
            document.getElementById('loadingOverlay').style.display = 'none';
        }
    });

    if (sessionStorage.getItem('loading') === 'true') {
        loadingOverlay.style.display = 'flex';
    }
    });


</script>

</body>
</html>