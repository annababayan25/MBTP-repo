@using System.Data
@model DataSet

@{
    ViewData["Title"] = "Populate Check Ins";
    var SelectedDay = ViewBag.SelectedDay as DateTime?;
    var titleDate = SelectedDay.HasValue
        ? $"for {SelectedDay.Value.ToString("dddd, MMMM dd, yyyy")}"
        : "";

    int checkInCount = 0;
    if (Model != null && Model.Tables.Count > 0)
    {
        checkInCount = Model.Tables[0].Rows.Count;
    }
}


<style>
.day-picker-row {
    display: flex;
    align-items: center;
    gap: 10px;   
    justify-content: center; 
    margin-bottom: 15px;
}

.day-picker-row label {
    margin-bottom: 0;
}

.small-btn {
    height: 38px; /* match input height */
}
</style>


<!DOCTYPE html>
<html lang="en">

<h2 style="text-align: center;">
    Daily Checked-In Report @titleDate
    @if (checkInCount > 0)
    {
        <p style="text-align: centered;">(Total Checked In: @checkInCount)</p>
    }
</h2>

<head>
    <meta charset="UTF-8" name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Checked In Report</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>

<div class="loading-overlay" id="loadingOverlay">
    <i class="fas fa-spinner fa-spin spinner"></i>
</div>


<form method="get" asp-action="PopulateCheckIns" class="navigation-container day-picker-row">
    <label for="dayPicker">Select Day:</label>
    <input type="text" id="dayPicker" name="day" value="@SelectedDay?.ToString("yyyy-MM-dd")">

    <button type="submit" class="btn btn-success small-btn" formaction="@Url.Action("ExportCheckInsToExcel")" formtarget="_blank">
        <i class="fas fa-file-excel"></i> Export
    </button>
</form>



@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

@if (Model != null && Model.Tables.Count > 0 && Model.Tables[0].Rows.Count > 0)
{
    <div class="table-responsive" style="max-height: 60vh; overflow-y: auto; max-width: 100vw; overflow-x: auto;">
        <table id="daily-table" style="width:auto; border: none;">
            <thead>
                <tr>
                    <th style="text-align:center;">Booking ID</th>
                    <th style="text-align:center;">Booking Name</th>
                    <th style="text-align:center;">Site</th>
                    <th style="text-align:center;">Status</th>
                    <th style="text-align:center;">Booking Arrival</th>
                    <th style="text-align:center;">Booking Departure</th>
                    <th style="text-align:center;">Booking Checked-In</th>
                    <th style="text-align:center;">Calculated Stay Cost</th>
                    <th style="text-align:center;">Deposits Held</th>
                    <th style="text-align:center;">Security Deposits</th>
                    <th style="text-align:center;">Lock Fee</th>
                    <th style="text-align:center;">Online Booking Fee</th>
                    <th style="text-align:center;">Payments Made After Check-In</th>
                    <th style="text-align:center;">Refunds</th>
                    <th style="text-align:center;">Cancellation Fee</th>
                    <th style="text-align:center;">Extras</th>
                    <th style="text-align:center;">Car Plate</th>
                    <th style="text-align:center;">Car Plate Extras</th>
                    <th style="text-align:center;">Account Balance</th>
                </tr>
            </thead>
            <tbody>
            @{
                var orderedRows = Model.Tables[0].AsEnumerable()
                    .OrderByDescending(r =>
                    {
                        DateTime parsed;
                        return DateTime.TryParse(r["BookingCheckedIn"]?.ToString(), out parsed)
                            ? parsed
                            : DateTime.MinValue;
                    });
            }
                @foreach (DataRow row in orderedRows)
                {
                <tr>
                    <td>@row["BookingId"]</td>
                    <td>@row["BookingName"]</td>
                    <td>@row["Site"]</td>
                    <td>@row["BookingStatus"]</td>
                    <td>
                        @(row["BookingArrival"] is DateTime bookingArrival
                        ? bookingArrival.ToString("MM/dd/yyyy hh:mm tt")
                        : "-")
                    </td>
                    <td>
                        @(row["BookingDeparture"] is DateTime bookingDeparture
                        ? bookingDeparture.ToString("MM/dd/yyyy hh:mm tt")
                        : "-")
                    </td>
                    <td>
                        @(row["BookingCheckedIn"] is DateTime bookingCheckedIn
                        ? bookingCheckedIn.ToString("MM/dd/yyyy hh:mm tt")
                        : "-")
                    </td>  
                    <td class="amount">
                        @(row["CalculatedStayCost"] != DBNull.Value
                            ? String.Format("{0:#,##0.00;(#,##0.00);-}", row["CalculatedStayCost"])
                            : "-")
                    </td>
                    <td class="amount">
                        @(row["DepositsHeld"] != DBNull.Value
                            ? String.Format("{0:#,##0.00;(#,##0.00);-}", row["DepositsHeld"])
                            : "-")
                    </td>
                    <td class="amount">
                        @(row["SecurityDeposits"] != DBNull.Value
                            ? String.Format("{0:#,##0.00;(#,##0.00);-}", row["SecurityDeposits"])
                            : "-")
                    </td>
                    <td class="amount">
                        @(row["LockFee"] != DBNull.Value
                            ? String.Format("{0:#,##0.00;(#,##0.00);-}", row["LockFee"])
                            : "-")
                    </td>
                    <td class="amount">
                        @(row["OnlineBookingFee"] != DBNull.Value
                            ? String.Format("{0:#,##0.00;(#,##0.00);-}", row["OnlineBookingFee"])
                            : "-")
                    </td>
                    <td class="amount">
                        @(row["PaymentsAfterCheckIn"] != DBNull.Value
                            ? String.Format("{0:#,##0.00;#,##0.00;-} {1}",
                                row["PaymentsAfterCheckIn"],
                                row["PaymentsAfterCheckInDesc"] != DBNull.Value ? row["PaymentsAfterCheckInDesc"] : "")
                            : "-")
                    </td>
                    <td class="amount">
                        @(row["Refunds"] != DBNull.Value
                            ? String.Format("{0:#,##0.00;(#,##0.00);-}", row["Refunds"])
                            : "-")
                    </td>
                    <td class="amount">
                        @(row["CancellationFee"] != DBNull.Value
                            ? String.Format("{0:#,##0.00;(#,##0.00);-}", row["CancellationFee"])
                            : "-")
                    </td>
                    <td class="amount" 
                        style="@(row["Extras"] != DBNull.Value ? "color:red;" : "")">
                        @(row["Extras"] != DBNull.Value
                            ? String.Format("{0:#,##0.00;(#,##0.00);-}", row["Extras"])
                            : "-")
                    </td>
                    <td>@row["CarLicensePlate"]</td>
                    <td>@row["CarLicensePlateExtra"]</td>
                    <td class="amount">
                        @(row["AccountBalance"] != DBNull.Value
                            ? String.Format("{0:#,##0.00;(#,##0.00);-}", row["AccountBalance"])
                            : "-")
                    </td>
                        
            </tr>
            }
            </tbody>
        </table>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/js/all.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function() {
    const loadingOverlay = document.getElementById('loadingOverlay');
    const form = document.querySelector('form');

    form.addEventListener('submit', function (e) {
        const submitter = e.submitter;

        if (submitter && submitter.formTarget === '_blank') {
            return
        }
        sessionStorage.setItem('loading', 'true');
        loadingOverlay.style.display = 'flex';
    });

    flatpickr("#dayPicker", {
        dateFormat: "Y-m-d",
        maxDate: "today",
        defaultDate: "@(SelectedDay.HasValue ? SelectedDay.Value.ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd"))",
        onChange: function(selectedDates, dateStr, instance) {
            var newUrl = new URL(window.location.href);
            newUrl.searchParams.set("day", dateStr); 
            sessionStorage.setItem('loading', 'true');
            loadingOverlay.style.display = 'flex';
            window.location.href = newUrl.toString();
        }
    });

    window.addEventListener('load', function() {
        loadingOverlay.style.display = 'none';
        sessionStorage.removeItem('loading');
    });

    window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
            document.getElementById('loadingOverlay').style.display = 'none';
        }
    });

    if (sessionStorage.getItem('loading') === 'true') {
        loadingOverlay.style.display = 'flex';
    }
    });


</script>

</body>
</html>